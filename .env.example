# ================= Global Dossier 国外局实审分析助手 配置示例 =================
# 复制为 .env 后按需修改；gd_helper.py 会自动读取。
# 注意：.env 已在 .gitignore 中，不会被提交，密钥不会泄漏到仓库。

# ── 大模型（OpenAI 兼容协议，报告生成用，必填）──────────────
LLM_API_BASE=https://note3-prev-api.askdiandian.com/v1
LLM_API_KEY=在这里填入你的大模型API密钥
LLM_MODEL=dots3-note-prev

# ── OCR：MinerU 精准解析 API（可选）────────────────────
# 不设置则回落本地 rapidocr。Token 在 https://mineru.net 申请（14 天有效）。
MINERU_API_KEY=

# ── Web 访问密码（可选，公网部署建议开启）──────────────────
# 设置后访问页面需 Basic Auth（用户名 gd）；也可启动时传 --password
# GD_PASSWORD=

# ── 其他（均有命令行参数可覆盖）────────────────────────
# 关注的国外局（默认 US,EP,JP,KR）
# OFFICES=US,EP,JP,KR
# 每局最多下载的实审文书数（默认 8，覆盖 通知书+引证清单+答复+权利要求）
# MAX_DOCS=8
